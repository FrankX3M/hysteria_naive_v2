# install.env.example — неинтерактивная установка: sudo ./install.sh --config install.env
# Скопируйте в install.env, заполните, НЕ коммитьте (см. .gitignore).
# После установки эти же значения лежат в /etc/proxy/install.env (секреты — в /etc/proxy/secrets.env).

# ── Обязательные ──────────────────────────────────────────────
SERVER_DOMAIN=proxy.example.com
# SERVER_IP=            # пусто = определить через ifconfig.me

# ── Сертификат: letsencrypt | selfsigned | existing ────────────
CERT_MODE=letsencrypt
# TLS_CERT=/path/fullchain.pem   # только для CERT_MODE=existing
# TLS_KEY=/path/privkey.pem

# ── Порты ─────────────────────────────────────────────────────
MAIN_PORT=443
HOP_START=20000
HOP_END=50000
# SSH_PORT=             # пусто = определить из sshd -T

# ── Пользователи ──────────────────────────────────────────────
FIRST_USER=admin

# ── Hysteria2 ─────────────────────────────────────────────────
HY2_OBFS=yes            # yes: salamander (стойкость к DPI), no: чистый QUIC + masquerade-заглушка
HY2_UP_MBPS=100
HY2_DOWN_MBPS=200

# ── Telegram (опционально) ────────────────────────────────────
# TG_TOKEN=123456:ABC...
# TG_CHAT_ID=123456789          # куда слать уведомления (личный чат или группа, у группы id отрицательный)
# TG_ADMIN_IDS=123456789,987654321   # кто может управлять ботом (user id, узнать: /whoami)

# ── Система ───────────────────────────────────────────────────
ENABLE_SWAP=auto        # auto | yes | no
SWAP_SIZE_MB=512
ENABLE_FAIL2BAN=yes
ENABLE_CLEANUP_TIMER=yes
NAIVE_MEM_LIMIT=256m
NAIVE_CPUS=1.0

# ── Бэкапы ────────────────────────────────────────────────────
# BACKUP_PASSPHRASE=    # пусто = сгенерировать; хранится в /etc/proxy/secrets.env
BACKUP_KEEP=7
